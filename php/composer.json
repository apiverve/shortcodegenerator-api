            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "shortcodegenerator",
        "short code",
        "code generator",
        "alphanumeric code",
        "random code",
        "url shortener"
    ],
    "homepage": "https://apiverve.com/marketplace/shortcodegenerator?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/shortcodegenerator",
        "source": "https://github.com/apiverve/shortcodegenerator-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
